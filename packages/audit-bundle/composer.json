{
    "name": "app/audit-bundle",
    "description": "Audit logging bundle for Symfony applications",
    "type": "symfony-bundle",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "symfony/framework-bundle": "^8.1",
        "doctrine/orm": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "App\\AuditBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\AuditBundle\\Tests\\": "tests/"
        }
    }
}
